  owner_id                    String?
  priority                    String?
  stage_entered_at            DateTime? @db.Timestamptz(6)
  twenty_created_at           DateTime? @db.Timestamptz(6)
  twenty_updated_at           DateTime? @db.Timestamptz(6)
  closure_sent_at             DateTime? @db.Timestamptz(6)

  @@index([stage, last_activity_at, reminder_1d_attempted_at], map: "idx_opportunities_reminder_1d", where: raw("((reminder_1d_sent = false) AND (reminder_1d_attempts < 3))"))
  @@index([reminder_1d_request_id], map: "idx_opportunities_reminder_1d_req", where: raw("(reminder_1d_request_id IS NOT NULL)"))
  @@index([stage, last_activity_at, reminder_1h_attempted_at], map: "idx_opportunities_reminder_1h", where: raw("((reminder_1h_sent = false) AND (reminder_1h_attempts < 3))"))
  @@index([reminder_1h_request_id], map: "idx_opportunities_reminder_1h_req", where: raw("(reminder_1h_request_id IS NOT NULL)"))
  @@index([stage, last_activity_at, reminder_3d_attempted_at], map: "idx_opportunities_reminder_3d", where: raw("((reminder_3d_sent = false) AND (reminder_3d_attempts < 3))"))
  @@index([reminder_3d_request_id], map: "idx_opportunities_reminder_3d_req", where: raw("(reminder_3d_request_id IS NOT NULL)"))
  @@index([assignee_email])
  @@index([last_meaningful_update_at])
  @@index([stage])
  @@index([twenty_updated_at])
