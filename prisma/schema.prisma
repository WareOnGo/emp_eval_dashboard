generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Employee {
  empID          String         @id
  role           String         @default("EMPLOYEE")
  createdAt      DateTime       @default(now())
  VerifiedNumber VerifiedNumber @relation(fields: [empID], references: [empID])
  Ticket         Ticket[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Attachment {
  id          String         @id
  ticketId    String
  name        String
  kind        AttachmentKind
  contentType String
  sizeBytes   Int
  r2Key       String         @unique
  createdAt   DateTime       @default(now())
  Ticket      Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CronRunLog {
  id         BigInt   @id @default(autoincrement())
  jobName    String
  ranAt      DateTime @default(now())
  status     String
  durationMs Int
  metadata   Json?
  notes      String?

  @@index([jobName, ranAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Draft {
  sender_number  String   @id
  status         String
  warehouse_data Json
  image_urls     String[]
  created_at     DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Enquiry {
  id           Int       @id @default(autoincrement())
  name         String
  phone_number String
  email        String?
  source       String
  createdat    DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model GeocodeAttempt {
  id            Int       @id @default(autoincrement())
  warehouseId   Int       @unique
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime  @default(now())
  lastVia       String?
  lastError     String?
  succeededAt   DateTime?

  @@index([lastAttemptAt])
  @@index([succeededAt])
}

model Guide {
  id              Int         @id @default(autoincrement())
  slug            String      @unique
  title           String
  seoTitle        String
  description     String
  summary         String
  keywords        String[]    @default([])
  blocks          Json
  faqs            Json
  related         String[]    @default([])
  datePublished   DateTime?   @db.Date
  dateModified    DateTime    @db.Date
  sortOrder       Int         @default(0)
  status          GuideStatus @default(DRAFT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  deployedAt      DateTime?
  deployedContent Json?
  author          String?

  @@index([status, sortOrder])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model MessageLog {
  id            Int      @id @default(autoincrement())
  received_at   DateTime @default(now())
  sender_number String
  message_body  String
  status        String
  error_message String?
  image_url     String?
}

