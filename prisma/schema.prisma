/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WarehouseData {
  id                  Int                       @id @default(autoincrement())
  latitude            Float?
  longitude           Float?
  embedding           Unsupported("vector")?
  warehouseId         Int                       @unique
  fireNocAvailable    Boolean?
  fireSafetyMeasures  String?
  landType            String?
  approachRoadWidth   String?
  dimensions          String?
  parkingDockingSpace String?
  pollutionZone       String?
  powerKva            String?
  vaastuCompliance    String?
  geog                Unsupported("geography")? @default(dbgenerated("\nCASE\n    WHEN ((longitude IS NOT NULL) AND (latitude IS NOT NULL)) THEN (st_setsrid(st_makepoint(longitude, latitude), 4326))::geography\n    ELSE NULL::geography\nEND"))
  Warehouse           Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([geog], map: "WarehouseData_geog_gist", type: Gist)
  @@index([fireNocAvailable], map: "idx_warehouse_fire_noc", where: raw("(\"fireNocAvailable\" = true)"))
}

